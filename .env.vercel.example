# Vercel Frontend Environment Variables
# Copy this file to .env.local and fill in the actual values

# API Configuration
NEXT_PUBLIC_API_URL=https://biketaxi-api.render.com
NEXT_PUBLIC_APP_NAME=BikeTaxi
NEXT_PUBLIC_ENVIRONMENT=production

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_SENTRY=true
NEXT_PUBLIC_ENABLE_DEBUG=false

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry Configuration
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Runtime Secrets (Not exposed to frontend)
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Build Variables
NEXT_PUBLIC_BUILD_TIME=production
