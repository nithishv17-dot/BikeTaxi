# ============================================================================
# BikeTaxi TypeScript Backend - Environment Variables
# ============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
# PostgreSQL (Phase 3+)
DATABASE_URL="postgresql://user:password@localhost:5432/biketaxi_pg"

# MongoDB (Phase 1-2, optional for backward compatibility)
MONGODB_URI="mongodb://127.0.0.1:27017/biketaxi"

# Authentication
JWT_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"

# Logging
LOG_LEVEL=debug
